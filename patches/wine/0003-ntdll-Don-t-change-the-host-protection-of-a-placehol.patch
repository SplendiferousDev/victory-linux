From 1023299d31ba29fd7785e4a93a860f1f5de9a4ae Mon Sep 17 00:00:00 2001
From: SplendiferousDev <361138182+SplendiferousDev@users.noreply.github.com>
Date: Wed, 25 Nov 2026 16:11:18 -0800
Subject: [PATCH 3/5] ntdll: Don't change the host protection of a placeholder
 before mapping a section over it.

virtual_map_section() maps the file with mmap(MAP_FIXED) over the whole
placeholder and then sets the final protection, so the mprotect() done in
map_view() is redundant. Only update the page protection bytes there for
section views.
---
 dlls/ntdll/unix/virtual.c | 21 +++++++++++++++++----
 1 file changed, 17 insertions(+), 4 deletions(-)

diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
index 0175639..5b8bfc8 100644
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -2072,11 +2072,11 @@ static int mprotect_range( void *base, size_t size, BYTE set, BYTE clear )
 
 
 /***********************************************************************
- *           set_vprot
+ *           set_view_page_vprot
  *
- * Change the protection of a range of pages.
+ * Set the protection bytes of a range of pages, without changing the host protection.
  */
-static BOOL set_vprot( struct file_view *view, void *base, size_t size, BYTE vprot )
+static void set_view_page_vprot( struct file_view *view, void *base, size_t size, BYTE vprot )
 {
     if (!use_kernel_writewatch && view->protect & VPROT_WRITEWATCH)
     {
@@ -2089,6 +2089,17 @@ static BOOL set_vprot( struct file_view *view, void *base, size_t size, BYTE vpr
         else if (use_kernel_writewatch && view->protect & VPROT_WRITEWATCH) vprot &= ~VPROT_WRITEWATCH;
         set_page_vprot( base, size, vprot );
     }
+}
+
+
+/***********************************************************************
+ *           set_vprot
+ *
+ * Change the protection of a range of pages.
+ */
+static BOOL set_vprot( struct file_view *view, void *base, size_t size, BYTE vprot )
+{
+    set_view_page_vprot( view, base, size, vprot );
     return !mprotect_range( base, size, 0, 0 );
 }
 
@@ -2503,7 +2514,9 @@ static NTSTATUS map_view( struct file_view **view_ret, void *base, size_t size,
         TRACE( "found view %p, size %p, protect %#x.\n", view->base, (void *)view->size, view->protect );
 
         view->protect = vprot | VPROT_PLACEHOLDER;
-        set_vprot( view, base, size, vprot );
+        /* section views are mapped over by the caller, which sets the host protection */
+        if (is_view_valloc( view )) set_vprot( view, base, size, vprot );
+        else set_view_page_vprot( view, base, size, vprot );
         if (vprot & VPROT_WRITEWATCH)
         {
             kernel_writewatch_register_range( view, base, size );
-- 
